<div class="musloop-body">
  {{#unless isGM}}
    <p class="musloop-hint">{{localize "MUSLOOP.GMOnly"}}</p>
  {{/unless}}

  <section class="musloop-tracks">
    <header>
      <h3>{{localize "MUSLOOP.Tracks"}}</h3>
      {{#if isGM}}
        <button type="button" data-action="importZip" title="{{localize 'MUSLOOP.ImportZipHint'}}"><i class="fa-solid fa-file-import"></i> {{localize "MUSLOOP.ImportZip"}}</button>
        <button type="button" class="{{#if packsOpen}}on{{/if}}" data-action="togglePacks" title="{{localize 'MUSLOOP.PacksHint'}}"><i class="fa-solid fa-box-open"></i> {{localize "MUSLOOP.Packs"}}</button>
        <button type="button" class="icon" data-action="refresh" title="{{localize 'MUSLOOP.Refresh'}}"><i class="fa-solid fa-rotate"></i></button>
        <input type="file" name="zip" accept=".zip" hidden />
      {{/if}}
    </header>
    {{#if packsOpen}}
    <div class="musloop-packs">
      <p class="musloop-hint">{{localize "MUSLOOP.PacksIntro"}}</p>
      {{#if packsLoading}}<p class="musloop-hint"><i class="fa-solid fa-spinner fa-spin"></i> {{localize "MUSLOOP.PacksLoading"}}</p>{{/if}}
      {{#each packs}}
        <div class="musloop-pack">
          <div class="musloop-pack-head">
            <b>{{name}}</b>
            {{#if error}}<span class="err">{{error}}</span>{{else}}<span class="meta">{{license}}{{#if credits}} · {{credits}}{{/if}}</span>{{/if}}
          </div>
          {{#if description}}<p class="musloop-hint">{{description}}</p>{{/if}}
          {{#each tracks}}
            <div class="musloop-pack-track {{#if installed}}installed{{/if}}">
              <span class="name">{{name}}</span>
              <span class="meta">{{artist}} · {{size_mb}} MB{{#if url}} · <a href="{{url}}" target="_blank" rel="noopener">source</a>{{/if}}</span>
              {{#if installed}}
                <span class="state"><i class="fa-solid fa-check"></i> {{localize "MUSLOOP.Installed"}}</span>
              {{else if installing}}
                <span class="state"><i class="fa-solid fa-spinner fa-spin"></i> {{#if pct}}{{pct}}%{{else}}{{installing.phase}}{{/if}}</span>
              {{else}}
                <button type="button" class="small" data-action="installTrack" data-pack="{{../id}}" data-slug="{{slug}}" {{#if ../../installingAny}}disabled{{/if}}><i class="fa-solid fa-download"></i> {{localize "MUSLOOP.Install"}}</button>
              {{/if}}
            </div>
          {{/each}}
        </div>
      {{/each}}
    </div>
    {{/if}}
    {{#if tracks.length}}
      <div class="musloop-track-list">
        {{#each tracks}}
          <button type="button" class="musloop-track {{#if active}}on{{/if}}" data-action="selectTrack" data-slug="{{slug}}">
            <span class="name">{{name}}</span>
            <span class="meta">{{n}} parts{{#if bpm}} · {{bpm}} BPM{{/if}}</span>
          </button>
        {{/each}}
      </div>
    {{else}}
      <p class="musloop-hint">{{localize "MUSLOOP.NoTracks"}}</p>
    {{/if}}
    {{#if loading}}<p class="musloop-hint"><i class="fa-solid fa-spinner fa-spin"></i> {{loading.done}} / {{loading.total}}</p>{{/if}}
  </section>

  {{#if hasTrack}}
  <section class="musloop-stage">
    <div class="musloop-now">
      <div class="label">{{#if playing}}{{localize "MUSLOOP.NowPlaying"}}{{else}}{{localize "MUSLOOP.Ready"}}{{/if}}</div>
      <div class="big">{{nowLabel}}</div>
      <div class="sub">{{#if playing}}<i class="fa-solid fa-wave-square"></i> {{localize "MUSLOOP.Pass"}} {{pass}}{{else}}{{trackName}}{{/if}}</div>
    </div>
    <div class="musloop-next {{#if next}}armed{{/if}}">
      <div class="label">{{localize "MUSLOOP.UpNext"}}</div>
      <div class="big">{{#if next}}{{next}}{{else}}—{{/if}}</div>
      <div class="sub">{{etaText}}</div>
    </div>
  </section>

  {{#if isGM}}
  <section class="musloop-transport">
    {{#if playing}}
      <button type="button" data-action="stop"><i class="fa-solid fa-stop"></i> {{localize "MUSLOOP.Stop"}}</button>
      <button type="button" class="go" data-action="next"><i class="fa-solid fa-forward-step"></i> {{localize "MUSLOOP.Next"}}</button>
      <button type="button" data-action="cancel" {{#unless next}}disabled{{/unless}}><i class="fa-solid fa-xmark"></i> {{localize "MUSLOOP.Cancel"}}</button>
      <button type="button" data-action="fade"><i class="fa-solid fa-arrow-down-wide-short"></i> {{localize "MUSLOOP.Fade"}}</button>
    {{else}}
      <button type="button" class="primary" data-action="play"><i class="fa-solid fa-play"></i> {{localize "MUSLOOP.Play"}}</button>
    {{/if}}
    <span class="musloop-mode">
      <span class="label">{{localize "MUSLOOP.Transition"}}:</span>
      {{#each modes}}<button type="button" class="pill {{#if on}}on{{/if}}" data-action="mode" data-mode="{{id}}">{{label}}</button>{{/each}}
    </span>
  </section>
  {{/if}}

  {{#if scenes.length}}
  <section>
    <h3>{{localize "MUSLOOP.Scenes"}}</h3>
    <div class="musloop-pads">
      {{#each scenes}}
        <button type="button" class="pad scene {{#if on}}on{{/if}} {{#if queued}}queued{{/if}}" style="--c: {{color}}" data-action="scene" data-k="{{k}}" {{#unless ../isGM}}disabled{{/unless}}>
          {{#if hotkey}}<kbd>⇧{{hotkey}}</kbd>{{/if}}
          <span class="name">{{name}}</span>
          <span class="sub">{{partName}} · {{cue}}</span>
          {{#if on}}<span class="state">{{localize "MUSLOOP.OnAir"}}</span>{{/if}}
          {{#if queued}}<span class="state">{{localize "MUSLOOP.Queued"}}</span>{{/if}}
        </button>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <section>
    <h3>{{localize "MUSLOOP.Parts"}}</h3>
    <div class="musloop-pads">
      {{#each parts}}
        <button type="button" class="pad {{#if on}}on{{/if}} {{#if queued}}queued{{/if}}" style="--c: {{color}}" data-action="part" data-index="{{i}}" {{#unless ../isGM}}disabled{{/unless}} {{#if oneShot}}title="{{localize 'MUSLOOP.BuildUp'}}"{{/if}}>
          {{#if key}}<kbd>{{key}}</kbd>{{/if}}
          <span class="name">{{name}}{{#if oneShot}} →{{/if}}</span>
          <span class="sub">{{dur}}</span>
          {{#if on}}<span class="state">{{localize "MUSLOOP.OnAir"}}</span>{{/if}}
          {{#if queued}}<span class="state">{{localize "MUSLOOP.Queued"}}</span>{{/if}}
        </button>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <footer class="musloop-foot">
    <label><i class="fa-solid fa-volume-high"></i> {{localize "MUSLOOP.Volume"}}
      <input type="range" name="volume" min="0" max="100" value="{{volume}}" />
      <span class="musloop-vol-num">{{volume}}%</span>
    </label>
    {{#if isGM}}<span class="musloop-players">{{localize "MUSLOOP.PlayersHear" n=players}}</span>{{/if}}
  </footer>
</div>
